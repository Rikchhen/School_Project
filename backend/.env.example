# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB or a MongoDB Atlas connection string
MONGO_URL=mongodb://127.0.0.1:27017/adarsha_school

# ---- Auth ----
# Use a long, random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET_TOKEN=change_me_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=adarsha_token

# ---- CORS / client ----
# The origin of the Vite frontend (used for CORS + socket.io)
CLIENT_URL=http://localhost:5173

# ---- Seed admin (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@adarsha.edu.np
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=School Administrator
