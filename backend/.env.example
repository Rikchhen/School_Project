# Copy this file to `.env` and fill in real values. See DEPLOY.md for going live.

# ---- Server ----
PORT=5000
# development | production | test
NODE_ENV=development

# ---- Database ----
# Local MongoDB, or a MongoDB Atlas connection string (recommended for production).
# Atlas example: mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/adarsha_school?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/adarsha_school

# ---- Auth / sessions ----
# PRODUCTION: must be unique and >= 32 chars (e.g. `openssl rand -hex 32`).
JWT_SECRET_TOKEN=change_me_to_a_long_random_secret_string
JWT_EXPIRES_IN=30m
SESSION_IDLE_MINUTES=30
COOKIE_NAME=adarsha_token
# Number of proxies in front of the app. Set to 1 behind Render/Heroku/Nginx so
# secure cookies work. Leave 0 for plain local development.
TRUST_PROXY=0
# Dev-only: skip admin auth for convenience. Ignored in production. Set false to test auth.
DISABLE_ADMIN_AUTH=true

# ---- CORS / client ----
# The public origin of the site (used for CORS + socket.io + cookies).
# Production: your live URL, e.g. https://adarsha-school.onrender.com or https://yourdomain.com
CLIENT_URL=http://localhost:5180

# ---- File uploads ----
# Absolute path to a persistent volume for uploaded files (images/videos/PDFs).
# PRODUCTION: point this at a mounted disk (e.g. /var/data) so files survive restarts.
# Empty = store files under the backend folder (fine for local development).
UPLOAD_ROOT=

# ---- Donations (optional feature) ----
# Days to keep donor-uploaded documents before automatic purge.
DONOR_RETENTION_DAYS=90
# PRODUCTION: must be unique and >= 32 chars — encrypts donor documents at rest.
DONOR_DOCUMENT_KEY=

# ---- Malware scanning (optional) ----
# Requires ClamAV installed on the host. Leave false unless you have it set up.
CLAMAV_ENABLED=false
CLAMAV_COMMAND=clamdscan

# ---- Seed admin (only used by `npm run seed`) ----
# WARNING: `npm run seed` DELETES all data and inserts sample content. Local/first-run only.
SEED_ADMIN_EMAIL=admin@adarsha.edu.np
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=School Administrator
