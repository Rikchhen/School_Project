# NOTE: `npm run dev` builds the site (vite build --watch) and the backend
# serves it at http://localhost:5000 — open THAT url. `npm run dev:hmr` starts
# the hot-reload Vite server at http://localhost:5180 instead.
#
# Base URL of the backend API.
# Leave as-is to use the Vite dev proxy (recommended for local dev):
VITE_API_URL=/api

# For a deployed frontend talking to a remote backend, use the full origin:
# VITE_API_URL=https://api.your-school-domain.edu.np/api
